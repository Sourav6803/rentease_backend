        <h2>Your Delivery OTP 🔐</h2>

        <p>Hello {{name}},</p>

        <p>A delivery is being completed for your order. Please share this <strong>one-time code</strong> with the delivery partner:</p>

        <div class="otp-box" style="margin: 24px 0; padding: 20px; background: #f8fafc; border: 2px dashed #f59e0b; border-radius: 12px; text-align: center;">
            <span style="font-size: 32px; font-weight: 800; letter-spacing: 8px; color: #1e293b;">{{otp}}</span>
        </div>

        <p style="color: #64748b; font-size: 13px;">
            ⏱️ This code is valid for <strong>{{expiryMinutes}} minutes</strong>. It will expire automatically.
        </p>

        {{#if deliveryNumber}}
        <div class="info-box">
            <strong>Delivery #{{deliveryNumber}}</strong>
        </div>
        {{/if}}

        <div class="alert" style="margin-top: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; color: #b91c1c; font-size: 13px;">
            ⚠️ <strong>Never share this OTP with anyone</strong> other than the verified delivery partner. RentEase will never call or message you asking for this code.
        </div>
